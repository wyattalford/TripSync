{
  "name": "opentime",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@mit-sdg/sync-engine": "1.1.0",
    "@mit-sdg/sync-engine-http": "1.1.0",
    "mongodb": "7.9.0"
  },
  "devDependencies": {
    "typescript": ">=6 <7",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "generate": "sync-engine artifacts pin",
    "check": "sync-engine check && sync-engine artifacts check && tsc --noEmit && bun run --cwd frontend typecheck",
    "check:design": "sync-engine check-design design/concepts/*.md design/types.md design/compositions/*.md",
    "test": "bun test",
    "build": "bun run --cwd frontend build",
    "start": "bun src/main.ts",
    "preview": "bun run db:up && bun run build && NODE_ENV=production PUBLIC_ORIGIN=http://127.0.0.1:3000 bun run start",
    "dev": "bun run db:up && bun run --parallel dev:backend dev:frontend",
    "dev:backend": "bun --watch src/main.ts",
    "dev:frontend": "bun run --cwd frontend dev",
    "db:up": "sh scripts/start-mongo.sh",
    "db:down": "podman compose down"
  }
}
